{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rynuvo",
  "version": "0.10.1",
  "identifier": "id.hypertopia.rynuvo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "maximized": true,
        "title": "Rynuvo",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#16171c",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' rynuvo-media: http://rynuvo-media.localhost data: blob: https://*.googleusercontent.com https://*.ggpht.com https://i.ytimg.com; style-src 'self' 'unsafe-inline'; media-src 'self' rynuvo-video: http://rynuvo-video.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "hardenedRuntime": false
    },
    "iOS": {
      "developmentTeam": "CM8AZJ6265"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzOTNCQTBGN0YzM0FBMkQKUldRdHFqTi9EN3FUWTl2MVNDblNBbTBvOW9xRmFwaXJrLzkxUHpxSXFBZENya2NLN2pTbWRPTXQK",
      "endpoints": [
        "https://rynuvo.pokyvl.my.id/downloads/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
